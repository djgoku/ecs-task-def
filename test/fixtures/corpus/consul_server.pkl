// Ported from aws-samples/aws-containers-task-definitions consul/ConsulServer.json
// (directory listing shows ConsulClient.json/ConsulServer.json, not the
// consul_ec2/consul_fargate naming used by the other apps in that repo)
amends "../../../pkl/EcsSchema.pkl"

// See nginx_fargate.pkl for why logConfiguration.options and dockerLabels
// need a converter instead of ordinary amending.
output {
  renderer = new JsonRenderer {
    converters {
      ["logConfiguration.options"] = (_) -> new Mapping {
        ["awslogs-group"] = "consul"
        ["awslogs-region"] = "us-east-2"
        ["awslogs-stream-prefix"] = "consulServer"
      }
      ["dockerLabels"] = (_) -> new Mapping {
        ["Name"] = "consulServer"
      }
    }
  }
}

family = "consulServer"
networkMode = "host"

containerDefinitions {
  new {
    name = "consulServer"
    image = "consul"
    cpu = 128
    memory = 256
    memoryReservation = 64
    entryPoint {
      "/usr/local/bin/docker-entrypoint.sh"
    }
    command {
      "agent"
      "-client=0.0.0.0"
      "-server"
      "-data-dir=/consul/data"
      "-bootstrap"
      "-ui"
    }
    environment {
      new {
        name = "CONSUL_BIND_INTERFACE"
        value = "eth0"
      }
      new {
        name = "enable_debug"
        value = "true"
      }
    }
    logConfiguration {
      logDriver = "awslogs"
    }
  }
}
